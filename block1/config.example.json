{
  "_comment": "Block 1 uses Google Trending Now (top_n up to 30) and falls back to Google Trends RSS (10 entries per region).",
  "_comment_2": "Trending Now is fetched by the pinned google-trends-now Node.js client in the GitHub Actions workflow.",

  "top_n": {
    "wikipedia": 30,
    "github": 25,
    "google_trends": 10
  },

  "wikipedia": {
    "days_back": 1
  },

  "github": {
    "queries": [
      {"since": "daily", "language": ""},
      {"since": "weekly", "language": "python"},
      {"since": "weekly", "language": "typescript"}
    ]
  },

  "google_trends_rss": {
    "enabled": true,
    "geos": ["US", "JP", "GB", "DE", "FR", "IT", "ES"],
    "source": "trending_now",
    "hours": 48,
    "sort": "volume",
    "top_n": 30,
    "trending_now_dir": "_generated/trending_now"
  }
}
